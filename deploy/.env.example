# Optional services: navidrome for a new server, proxy for the bundled Caddy.
# Separate several with commas; empty for an existing Navidrome.
COMPOSE_PROFILES="navidrome"
# Set by the release archive. Use the image version without the leading v.
BEATSTASH_VERSION=""
BOT_TOKEN=""
# Generate with: openssl rand -base64 32
SECRET_KEY=""
NAVIDROME_PASSWORD=""
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=""
