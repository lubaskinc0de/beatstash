# Secrets only; every other setting lives in config.toml (see config.example.toml).
DB_DSN="host=localhost user=postgres password=postgres dbname=postgres port=5432 sslmode=disable"
BOT_TOKEN=""
# base64 of 32 random bytes, encrypts stored Navidrome passwords: openssl rand -base64 32
SECRET_KEY=""
# Password of the Navidrome admin named in config.toml.
NAVIDROME_PASSWORD=""
# Local Telegram Bot API server, read by its container only.
# Get api_id/api_hash at https://my.telegram.org. Before the first start
# against it, log the bot out of the cloud Bot API once:
#   curl https://api.telegram.org/bot$BOT_TOKEN/logOut
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
